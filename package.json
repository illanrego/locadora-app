{
  "name": "wills-locadora-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop Will's Locadora experience with an isolated Stremio-compatible media engine",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test && npm run build",
    "check:native-core": "cargo test --manifest-path crates/native-core/Cargo.toml",
    "check:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@stremio/stremio-video": "^0.0.98",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
